# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS python-builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv
WORKDIR /build
RUN python -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY backend/app/ backend/app/
RUN pip install --upgrade pip \
    && pip install "uv==0.12.5" \
    && uv export --frozen --no-dev --extra mp-browser --no-editable --no-emit-project \
        --format requirements.txt --output-file /tmp/requirements.txt > /dev/null \
    && pip install --require-hashes --requirement /tmp/requirements.txt \
    && pip install --no-deps . \
    && pip uninstall --yes uv cachecontrol msgpack setuptools wheel \
    && pip uninstall --yes pip

FROM python:3.12-slim AS runtime
ARG APP_UID=10001
ARG APP_GID=10001
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    PYTHONPATH=/app/backend \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY --from=python-builder /opt/venv /opt/venv
COPY backend/ backend/

# Install Playwright browser and system dependencies as root
RUN apt-get update \
    && apt-get upgrade -y \
    && mkdir -p /ms-playwright \
    && python -m playwright install --with-deps chromium \
    && chmod -R 755 /ms-playwright \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "$APP_GID" notifyhub \
    && useradd --uid "$APP_UID" --gid "$APP_GID" --create-home --shell /usr/sbin/nologin notifyhub \
    && mkdir -p /app/browser-data/profile /app/browser-data/artifacts \
    && chown -R notifyhub:notifyhub /app

USER notifyhub
VOLUME ["/app/browser-data"]

CMD ["python", "-m", "app.mp_browser"]
