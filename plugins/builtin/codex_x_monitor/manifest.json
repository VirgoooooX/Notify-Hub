{
  "id": "codex_x_monitor",
  "name": "Codex X Monitor",
  "version": "0.6.1",
  "description": "监控指定 X 账号中的 Codex 用量重置消息",
  "entrypoint": "plugin:CodexXMonitorPlugin",
  "api_version": "1",
  "kind": "monitor",
  "trusted": true,
  "default_schedule": {
    "type": "cron",
    "expression": "*/10 9-20 * * 1-6",
    "timezone": "America/Los_Angeles"
  },
  "max_concurrency": 1,
  "timeout_seconds": 60,
  "permissions": {
    "network": [],
    "secrets": [],
    "broadcast": false,
    "publish_mp": true,
    "media_write": false,
    "x_source": true,
    "ai_capabilities": ["classify", "summarize"]
  }
}
