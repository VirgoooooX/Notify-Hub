# Copy to .env for Docker Compose. Never commit real credentials.
NOTIFY_HUB_ENVIRONMENT=production
NOTIFY_HUB_PUBLIC_BASE_URL=https://notify.example.com

# WeCom Channel config
NOTIFY_HUB_WECOM_CORP_ID=
NOTIFY_HUB_WECOM_AGENT_ID=
NOTIFY_HUB_WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
NOTIFY_HUB_ALLOW_BROADCAST=true

# Official Account (公众号) Article Publishing - optional
# Personal subscription accounts cannot use the official publish API.
# NOTIFY_HUB_MP_PUBLISH_MODE: library | draft | publish | browser
# - library: store articles in workbench for manual review.
# - browser: automatically publish via independent Playwright container (no AppID/Secret needed).
# - draft/publish: official Weixin API (requires AppID & Secret).
NOTIFY_HUB_MP_APP_ID=
NOTIFY_HUB_MP_APP_SECRET=
NOTIFY_HUB_MP_PUBLISH_MODE=browser
NOTIFY_HUB_MP_AUTHOR=Notify Hub
NOTIFY_HUB_BROWSER_PUBLISHER_API_URL=http://192.168.31.100:8790
NOTIFY_HUB_BROWSER_PUBLISHER_ACCESS_TOKEN=

# Secrets. Set these values locally in your .env file.
# Keep them strong (at least 32 characters) in production.
NOTIFY_HUB_SECRET_ENCRYPTION_KEY=
NOTIFY_HUB_JWT_SECRET=
NOTIFY_HUB_WECOM_SECRET=
NOTIFY_HUB_WECOM_CALLBACK_TOKEN=
NOTIFY_HUB_WECOM_CALLBACK_AES_KEY=

# X source integration. RSSHub owns the X Cookie/auth_token; Notify Hub only
# reads normalized RSSHub routes. Use a JSON array for alert recipients.
NOTIFY_HUB_X_SOURCE_PROVIDER=rsshub
NOTIFY_HUB_RSSHUB_BASE_URL=http://rsshub:1200
NOTIFY_HUB_RSSHUB_ACCESS_KEY=
NOTIFY_HUB_X_HEALTH_ALERT_ENABLED=true
NOTIFY_HUB_X_HEALTH_ALERT_RECIPIENT_IDS=[]
# Optional cold standby only; leave unset during normal RSSHub operation.
NOTIFY_HUB_X_TWSCRAPE_COOKIE=

# External plugin images may be downloaded above the 2 MiB channel limit and
# are recompressed before being stored/sent. This is still a bounded limit.
NOTIFY_HUB_MEDIA_SOURCE_IMAGE_MAX_BYTES=16777216

# Optional AI Gateway bootstrap. Leave disabled/blank to configure later in the admin UI.
NOTIFY_HUB_AI_ENABLED=false
NOTIFY_HUB_AI_BOOTSTRAP_PRESET=custom
NOTIFY_HUB_AI_BOOTSTRAP_BASE_URL=
NOTIFY_HUB_AI_BOOTSTRAP_MODEL=
NOTIFY_HUB_AI_BOOTSTRAP_API_KEY=

